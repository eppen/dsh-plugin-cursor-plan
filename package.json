{
  "name": "dsh-plugin-cursor-plan",
  "version": "0.1.1",
  "type": "module",
  "description": "DeepSeek Harness plugin: read Cursor Plan mode plans (*.plan.md) via a read-only cursor_plan tool",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cursor",
    "plan",
    "plan-mode",
    "read-only"
  ],
  "author": "eppen",
  "license": "MIT",
  "homepage": "https://github.com/eppen/dsh-plugin-cursor-plan#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eppen/dsh-plugin-cursor-plan.git"
  },
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./plan-store": "./lib/plan-store.mjs",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/",
    "locale/",
    "cordis.patch.yml",
    "market/",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/",
    "build:index": "node scripts/build-index.mjs",
    "check:index": "node scripts/check-index.mjs market/index.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.0"
  }
}
